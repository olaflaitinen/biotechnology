# =============================================================================
#  .gitignore
# -----------------------------------------------------------------------------
#  What must never enter version control.
#
#  ORGANISING PRINCIPLE
#  Sections in order of how often they are hit, so the file is scannable.
#  Every non-obvious entry carries a comment saying why it is here, because an
#  unexplained ignore rule is how a needed file silently fails to be committed.
#
#  NOTE ON docs/
#  docs/ is GENERATED by tools/generate_docs.py but is deliberately NOT ignored.
#  It is committed so that the rendered reference is browsable on GitHub without
#  a build step, and so that a change to a record shows its documentation
#  consequences in the same diff. A pre-commit hook checks it has not been
#  hand-edited.
#
#  SPDX-License-Identifier: EUPL-1.2
# =============================================================================

# -----------------------------------------------------------------------------
#  Python bytecode and caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# -----------------------------------------------------------------------------
#  Packaging and distribution
# -----------------------------------------------------------------------------
build/
dist/
sdist/
wheels/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
var/
*.egg-info/
*.egg
MANIFEST
pip-wheel-metadata/
share/python-wheels/

# -----------------------------------------------------------------------------
#  Virtual environments
#  Several names are listed because contributors use different conventions and
#  a stray committed venv is a multi-hundred-megabyte accident.
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.env/
virtualenv/
.python-version

# -----------------------------------------------------------------------------
#  Testing and coverage
# -----------------------------------------------------------------------------
.pytest_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.benchmarks/
nosetests.xml
*.cover

# -----------------------------------------------------------------------------
#  Type checking and linting caches
# -----------------------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# -----------------------------------------------------------------------------
#  Tox and nox
# -----------------------------------------------------------------------------
.tox/
.nox/

# -----------------------------------------------------------------------------
#  Documentation build output
#  site/ is the rendered HTML from mkdocs; docs/ is the generated Markdown and
#  IS committed. Do not add docs/ here.
# -----------------------------------------------------------------------------
site/
_build/
.doctrees/

# -----------------------------------------------------------------------------
#  Editors and IDEs
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.\#*
\#*\#
*.sublime-project
*.sublime-workspace
.spyderproject
.spyproject
.ropeproject

# -----------------------------------------------------------------------------
#  Operating system artefacts
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
#  Jupyter and IPython
#  Notebooks are not used in this project, but contributors experiment.
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# -----------------------------------------------------------------------------
#  Secrets and local configuration
#  Nothing in this project needs a secret at runtime, and the release workflow
#  uses PyPI trusted publishing rather than a token. These entries exist so
#  that an experiment never becomes a leak.
# -----------------------------------------------------------------------------
.env
.envrc
*.pem
*.key
*.p12
secrets.toml
.secrets/
.pypirc

# -----------------------------------------------------------------------------
#  Scratch space
#  A conventional place to put working files that must never be committed.
# -----------------------------------------------------------------------------
scratch/
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej

# -----------------------------------------------------------------------------
#  Exported artefacts
#  `biotechnology export` writes these by default; they are derived data and
#  are regenerated on demand.
# -----------------------------------------------------------------------------
taxonomy.json
taxonomy.csv
graph.dot
*.svg.tmp

# Crossref metadata cache written by tools/verify_references.py. Regenerable,
# and it would otherwise be a large churning blob in every diff.
tools/.crossref_cache.json
